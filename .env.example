# 复制为 .env 并填入你的 Key

# ── 方案 A（免费推荐）：魔搭 ModelScope API-Inference ──
# 1. 注册 https://modelscope.cn → 绑定阿里云中国站账号+实名（必须，否则 401）
# 2. 生成「访问令牌」（ms- 开头）：https://modelscope.cn/my/myaccesstoken
# 3. 免费额度约 2000 次/天；模型全是现成的，无需部署
#
# 实测可用的现成模型（任选）：
#   Qwen/Qwen3.8-Flash-Next    快，出题~11s / 判定~1s（默认推荐）
#   Qwen/Qwen3.5-27B           质量更好
#   deepseek-ai/DeepSeek-V4-Pro 质量最高（思考型，较慢）
#   ZhipuAI/GLM-5.2 / GLM-4.7-Flash
# 完整清单：GET {OPENAI_BASE_URL}/models
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=ms-xxxxxxxxxxxxxxxx
OPENAI_MODEL=Qwen/Qwen3.8-Flash-Next

# 关闭 Qwen 思考模式（不加会超时数十秒）；不支持的模型会自动去掉该参数重试
LLM_EXTRA_BODY={"enable_thinking": false}

# ── 方案 B：智谱 GLM（免费，注册即用，无需实名）──
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_API_KEY=你的智谱Key
# OPENAI_MODEL=glm-4-flash
# LLM_EXTRA_BODY={}

# ── 方案 C：DeepSeek 官方（付费）──
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=deepseek-chat

LLM_TIMEOUT=90
PORT=7860
# 默认单房间：所有人进同一房间；留空/改名可自定义，多房间功能仍保留
DEFAULT_ROOM=HALL
